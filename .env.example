PORT=3300

# Required for full AI identify + field extraction (Google AI Studio / Gemini).
# Without this key, local Tesseract still classifies Aadhaar/PAN via checksums/keywords.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional alias accepted by the service:
# GOOGLE_API_KEY=
# Optional preferred model (defaults try several flash models):
# GEMINI_MODEL=gemini-2.5-flash

# Shared with Nest backend OCR_SERVICE_API_KEY
OCR_SERVICE_API_KEY=change-me-ocr-shared-secret
OCR_RATE_LIMIT_WINDOW_MS=60000
OCR_RATE_LIMIT_MAX=60
NODE_ENV=development
